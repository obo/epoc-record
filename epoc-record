#!/usr/bin/env python3
"""Digitize EmotivPRO's live multi-channel EEG plot via X11 screen capture
and stream it as CSV on stdout, in a format a live-plotting tool can plot
live (see README.md).

Per-channel EEG data cannot be read from the EPOC X over BLE (the BLE
payload is encrypted) and EmotivPRO does not expose it through any local
API either -- the live scrolling chart in the EmotivPRO GUI is the only
place per-electrode waveform data exists at all on this machine, so this
script reads it visually: it finds the "EmotivPRO ..." window, takes a
screenshot of it every ``--delay`` seconds, and for each of the 14
electrodes finds that channel's uniquely-colored curve in the plot and
reads off its vertical (uV) position column by column. It also reads the
small color-coded quality dot next to each channel's name in the on-screen
legend, using a fixed quality color legend (see epoc_graph.QUALITY_LEGEND).

This script is strictly PASSIVE/READ-ONLY: it only takes screenshots and
queries window geometry. It never sends synthetic mouse/keyboard input and
never otherwise touches the EmotivPRO window, so it is always safe to run
alongside a real, currently-recording EmotivPRO session.

The actual screen-reading machinery (window capture, OCR, plot-geometry,
curve digitization, stitching, CSV output) lives in the sibling module
``epoc_graph.py``, shared with the actively-clicking ``epoc-reread``
companion script -- this file is just the live-capture CLI loop around it.

Output contract
----------------
stdout carries ONLY clean CSV (one header row, then one data row per
digitized plot pixel-column across all captures, stitched into one
continuous non-decreasing timestamp stream). All logging/diagnostics go to
stderr. Missing/unreadable samples (a curve obscured by another
overlapping curve, or any value we could not confidently read) are emitted
as empty fields -- NEVER interpolated/guessed -- which ``live-viewer``
(and most other CSV consumers) treat as "no sample, hold last value".

Columns::

    timestamp_ns, timestamp_iso,
    AF3, F7, F3, FC5, T7, P7, O1, O2, P8, T8, FC6, F4, F8, AF4,
    AF3_q, F7_q, F3_q, FC5_q, T7_q, P7_q, O1_q, O2_q, P8_q, T8_q, FC6_q, F4_q, F8_q, AF4_q

The ``*_q`` columns are the quality tier of each channel's contact/signal
quality dot, coded 0=off, 1=poor, 2=fair, 3=good (empty when unreadable or
"stale"/no-data-yet). Unlike the EEG columns (redrawn every capture from
the full visible waveform), quality is a single point-in-time snapshot per
capture -- there is no historical quality trace on screen to recover.

Example usage::

    ./epoc-record | your-live-plotting-tool --width=10s ...

See README.md for the specific companion tool this is normally piped into.

Known limitations (see README.md for more detail):

* Resolution ceiling: one sample per plot pixel-column, far below the
  headset's real ~256Hz sample rate.
* The EmotivPRO window must be on screen and not covered by another window
  for the covered region to be readable at all -- this is a fundamental
  property of screenshotting, not a bug.
* Quality columns are point-in-time snapshots, not continuous traces.
"""

import argparse
import signal
import sys
import time
from typing import Optional

from Xlib import display

from epoc_graph import Capture, CSVWriter, Stitcher, digitize_capture

DEFAULT_DELAY = 7.0
MAX_DELAY = 9.0


def delay_type(s: str) -> float:
    try:
        v = float(s)
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a float: {s!r}")
    if v <= 0:
        raise argparse.ArgumentTypeError("--delay must be > 0")
    if v > MAX_DELAY:
        raise argparse.ArgumentTypeError(
            f"--delay must be <= {MAX_DELAY} (the plot's rolling window is "
            "~10s; a larger delay can't guarantee >=1s overlap between "
            "consecutive captures, which the stitching logic depends on)"
        )
    return v


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument(
        "--delay",
        type=delay_type,
        default=DEFAULT_DELAY,
        help=f"seconds between screenshots (default {DEFAULT_DELAY}, max {MAX_DELAY})",
    )
    parser.add_argument(
        "--verbose", "-v", action="store_true", help="extra diagnostics on stderr"
    )
    parser.add_argument(
        "--once", action="store_true", help="capture+digitize+emit a single time, then exit"
    )
    args = parser.parse_args()

    d = display.Display()
    cap = Capture(d)
    writer = CSVWriter()
    stitcher = Stitcher(verbose=args.verbose)

    def cleanup(*_):
        writer.flush()
        sys.stderr.write("\n[epoc-record] stopped\n")
        sys.exit(0)

    signal.signal(signal.SIGINT, cleanup)
    signal.signal(signal.SIGTERM, cleanup)

    last_spacing_uv: Optional[float] = None
    next_tick = time.monotonic()
    while True:
        t0 = time.monotonic()
        frame = cap.capture_frame(verbose=args.verbose)
        if frame is None:
            sys.stderr.write("[warn] EmotivPRO window not found/readable this tick\n")
        else:
            result, spacing_used = digitize_capture(frame, last_spacing_uv, verbose=args.verbose)
            if spacing_used is not None:
                last_spacing_uv = spacing_used
            if result is not None:
                stitcher.process(result, writer)
                writer.flush()
                if args.verbose:
                    sys.stderr.write(
                        f"[capture] spacing={last_spacing_uv} samples={len(result.samples)} "
                        f"window={result.window_width}px\n"
                    )

        if args.once:
            break

        elapsed = time.monotonic() - t0
        if elapsed > args.delay and args.verbose:
            sys.stderr.write(
                f"[warn] digitization took {elapsed:.2f}s, longer than --delay={args.delay}s; "
                "falling behind schedule risks losing the guaranteed capture overlap\n"
            )
        next_tick += args.delay
        sleep_for = next_tick - time.monotonic()
        if sleep_for > 0:
            time.sleep(sleep_for)
        else:
            next_tick = time.monotonic()


if __name__ == "__main__":
    main()
